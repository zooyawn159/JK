pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                // 소스코드 체크아웃
                checkout scm
            }
        }
        stage('Build') {
            steps {
                // 윈도우 환경이므로 sh 대신 bat 사용
                bat 'javac -encoding UTF-8 -d classes Practice/src/**/*.java'
            }
        }
        stage('Test') {
            steps {
                // JUnit 5 테스트 실행을 위한 classpath 설정 및 실행 스크립트
                def classpath = "classes;lib/; path/to/eclipse/plugins/junit-platform-colsole-standalone-1.7.1.jar"
                bat 'java-cp classes;lib/; path to eclipse/plugins/junit-platform-console-standalone-1.7.1.jar org.junit.platform.console.ConsoleLauncher --scan-classpat > test_results.txt'
            }
        }
    }
    post {
        always {
            archiveArtifacts 'test_results.txt'
        }
        failure {
            echo 'Build or test failed'
        }
        success {
            echo 'Build and test succeeded'
        }
    }
}
